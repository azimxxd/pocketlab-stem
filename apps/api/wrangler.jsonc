{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pocketlab-class",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Only the production site may call the API from a browser. Local origins come from .dev.vars.
  "vars": { "ALLOWED_ORIGINS": "https://pocketlab-stem.vercel.app" },
  // Per-client limit for creating and joining rooms (keys: create:<ip>, join:<ip>).
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
  // Request metadata only: the worker never logs bodies, tokens or pseudonyms.
  "observability": { "enabled": true },
}
